# =============================================================================
# Vysify — variáveis de ambiente
# Copie para .env (local) e configure as mesmas variáveis na Vercel (produção).
# NUNCA versione o arquivo .env com valores reais.
#
# Quase tudo abaixo de "Segredos" também pode ser configurado no painel Admin
# (IA e custos, Pagamentos, Integrações, Configurações gerais), sem redeploy.
# O painel vence a variável; a variável vale como reserva quando o campo do painel
# está vazio. Só o banco, as URLs, NEXTAUTH_SECRET, ENCRYPTION_KEY, CRON_SECRET e o
# armazenamento S3 precisam ficar aqui.
# =============================================================================

# --- Banco de dados (Neon Postgres) -------------------------------------------
# No painel do Neon › Connect: copie a string COM pooler (host com "-pooler") para DATABASE_URL e a string SEM
# pooler para DIRECT_URL (usada só pelas migrations). Crie o projeto na região AWS São Paulo (sa-east-1).
# O app completa sozinho pgbouncer=true, sslmode=require e connect_timeout=15 (lib/db-url.ts).
# Com a integração Neon da Vercel, DATABASE_URL e DATABASE_URL_UNPOOLED já vêm prontas (DIRECT_URL é opcional).
DATABASE_URL="postgresql://USUARIO:SENHA@ep-NOME-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-NOME.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Migrations no build da Vercel: production (padrão) | always (inclui previews) | never
MIGRATE_ON_BUILD="production"

# --- URLs ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Segredos (gere valores aleatórios: openssl rand -base64 32) -------------
NEXTAUTH_SECRET=""
# Criptografa as chaves de API salvas pelo painel admin. Se mudar, as chaves salvas precisam ser recadastradas.
ENCRYPTION_KEY=""
# Protege /api/cron/jobs e o disparo interno /api/jobs/run (envie como "Authorization: Bearer <valor>")
CRON_SECRET=""

# --- Monitoramento de erros (opcional, Sentry) ----------------------------------
# Sem estas variáveis o Sentry fica desligado e nem é carregado. O DSN do navegador
# entra no build: depois de definir, faça um novo deploy.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Login com Google (opcional) ------------------------------------------------
# Prefira cadastrar em Admin › Integrações › Login com Google (liga/desliga sem redeploy).
# Estas variáveis valem como reserva quando o painel estiver vazio.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-mails transacionais (Resend) -------------------------------------------
# Sem a chave, os links de verificação/recuperação aparecem apenas no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="Vysify <nao-responda@seudominio.com.br>"

# --- Armazenamento (Cloudflare R2, compatível com S3) — obrigatório em produção --
# R2 › Create bucket; R2 › Manage API tokens (Object Read & Write no bucket). O acesso público do bucket
# (domínio próprio ou r2.dev) vira o S3_PUBLIC_URL. Veja docs/DEPLOY_VERCEL_NEON.md (inclui o CORS).
S3_BUCKET="vysify-uploads"
S3_REGION="auto"
S3_ENDPOINT="https://ID_DA_CONTA.r2.cloudflarestorage.com"
S3_PUBLIC_URL="https://arquivos.seudominio.com.br"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Provedores de IA (opcional aqui: também podem ser cadastrados no painel Admin)
GEMINI_API_KEY=""
FAL_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
OPENAI_API_KEY=""

# --- Pagamentos (opcional aqui: também podem ser cadastrados no painel Admin) --
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "true" calcula IVA/sales tax no checkout (exige o Stripe Tax ativado e registros fiscais na Stripe)
STRIPE_AUTOMATIC_TAX="false"

# --- Meta: publicação no Instagram e no Facebook (docs/META_SETUP.md) ----------
# Também podem ser cadastrados no painel Admin › Integrações.
META_APP_ID=""
META_APP_SECRET=""
# ID da configuração do "Login do Facebook para Empresas" (opcional; sem ele usa scopes)
META_LOGIN_CONFIG_ID=""
META_GRAPH_VERSION="v23.0"

# --- Dados da empresa (exigidos pelo Decreto 7.962/2013 e exibidos nos Termos) -
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_COMPANY_CNPJ=""
NEXT_PUBLIC_COMPANY_ADDRESS=""
NEXT_PUBLIC_SUPPORT_EMAIL="suporte@seudominio.com.br"
NEXT_PUBLIC_PRIVACY_EMAIL="privacidade@seudominio.com.br"
# Representantes exigidos pelo GDPR (art. 27) / UK GDPR ao atender clientes na UE e no Reino Unido.
# Nome e endereço exibidos na Privacy Policy em inglês (vazio = seção omitida).
NEXT_PUBLIC_EU_REPRESENTATIVE=""
NEXT_PUBLIC_UK_REPRESENTATIVE=""

# --- Análise e marketing (opcionais; só carregam após consentimento) ------------
# Sem nenhum dos dois, o banner de cookies nem aparece (só há cookies essenciais).
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Apenas testes ---------------------------------------------------------------
# Banco SEPARADO para os testes de integração (npm test). Nunca use o de produção.
TEST_DATABASE_URL=""
