generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String?
  image               String?
  passwordHash        String?
  emailVerified       DateTime?
  role                String    @default("USER") // USER ou SUPERADMIN
  onboardingCompleted Boolean   @default(false)
  onboardingRole      String?
  onboardingGoal      String?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  // Incrementado na troca de senha / logout global: invalida sessões antigas
  sessionVersion      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  notifyOnComplete    Boolean   @default(true)
  marketingOptIn      Boolean   @default(false)
  // Idioma da interface e dos e-mails (pt, en)
  locale              String    @default("pt")
  // País detectado no cadastro (ISO 3166-1 alpha-2), para moeda/impostos
  country             String?
  // Versão dos Termos/Privacidade aceita por último (ver lib/terms.ts e ConsentRecord)
  termsVersion        String?
  termsAcceptedAt     DateTime?
  // Workspace em uso (quem participa de mais de um, por convite, escolhe no menu)
  activeWorkspaceId   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspaces         WorkspaceMember[]
  creditBalances     CreditBalance[]
  creditTransactions CreditTransaction[]
  usageRecords       UsageRecord[]
  authTokens         AuthToken[]
  payments           Payment[]
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  type      String // VERIFY_EMAIL, RESET_PASSWORD
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Workspace {
  id               String   @id @default(uuid())
  name             String
  // Cliente na Stripe (assinaturas e portal de cobrança)
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  subscriptions Subscription[]
  metaAds       MetaAd[]
  adInsights    AdInsight[]
  products      Product[]
  campaigns     Campaign[]
  creditBalance CreditBalance?
  brandKit      BrandKit?
  connections   Connection[]
  publications  Publication[]
}

// Conta externa conectada por OAuth (Meta, e no futuro Mercado Livre, Nuvemshop...)
model Connection {
  id             String    @id @default(uuid())
  workspaceId    String
  provider       String // META, MERCADOLIVRE, NUVEMSHOP
  externalUserId String // id do usuário (Meta/ML) ou da loja (Nuvemshop)
  displayName    String?
  accessToken    String // criptografado (lib/crypto.ts)
  refreshToken   String? // criptografado; o do Mercado Livre é de uso único e rotaciona
  tokenExpiresAt DateTime?
  scopes         String?
  // Lista NÃO secreta de destinos (páginas, contas do Instagram) para exibir na UI
  assetsJson     String?
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@unique([workspaceId, provider])
  @@index([provider, externalUserId])
}

// Resultados de um criativo no mundo real: anúncio pago (Meta Ads) ou post orgânico (Instagram) criados pelo Vysify.
// Totais acumulados desde o início (date_preset=maximum), atualizados pelo cron e pelo botão "Atualizar resultados".
model AdInsight {
  id          String   @id @default(uuid())
  workspaceId String
  creativeId  String
  source      String // META_AD, INSTAGRAM_POST
  sourceId    String // MetaAd.id ou Publication.id
  // Situação do anúncio na Meta (ACTIVE, PAUSED, ...)
  status      String?
  impressions Int      @default(0)
  reach       Int      @default(0)
  // Cliques no link
  clicks      Int      @default(0)
  // Investimento, na moeda da conta de anúncios
  spend       Float    @default(0)
  currency    String?
  // Compras e receita atribuídas (pixel/API de conversões da conta)
  purchases   Int      @default(0)
  revenue     Float    @default(0)
  // Curtidas + comentários + salvos + compartilhamentos
  engagement  Int      @default(0)
  videoViews  Int      @default(0)
  error       String?
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creative  Creative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([creativeId])
  @@index([workspaceId, syncedAt])
}

model Publication {
  id           String   @id @default(uuid())
  workspaceId  String
  creativeId   String
  connectionId String?
  provider     String // META, MERCADOLIVRE, NUVEMSHOP
  // INSTAGRAM_FEED, INSTAGRAM_REELS, INSTAGRAM_STORY, FACEBOOK_PAGE, MERCADOLIVRE_ITEM, NUVEMSHOP_PRODUCT
  target       String
  accountId    String // conta do Instagram, Página, anúncio do ML ou produto da Nuvemshop
  accountName  String?
  caption      String?
  optionsJson  String? // ex.: {"asCover": true} para lojas
  status       String   @default("PENDING") // PENDING, PROCESSING, PUBLISHED, FAILED
  containerId  String? // container do Instagram (vídeos são processados de forma assíncrona)
  externalId   String? // id do post publicado
  permalink    String?
  error        String?
  attempts     Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creative   Creative    @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([creativeId])
  @@index([status, updatedAt])
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model BrandKit {
  id           String   @id @default(uuid())
  workspaceId  String   @unique
  brandName    String?
  primaryColor String?
  tone         String?
  website      String?
  logoUrl      String?
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Product {
  id               String   @id @default(uuid())
  workspaceId      String
  name             String
  description      String?
  price            Float?
  currency         String   @default("BRL")
  category         String?
  targetAudience   String?
  brandName        String?
  originalImageUrl String
  // Link da loja de onde o produto foi importado
  sourceUrl        String?
  // Avaliações dos compradores importadas da loja (JSON {rating: {value, count} | null, items: [{rating, text}]})
  reviewsJson      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([workspaceId, createdAt])
}

model Campaign {
  id                     String    @id @default(uuid())
  workspaceId            String
  productId              String
  userId                 String?
  name                   String
  objective              String
  tone                   String
  targetAudience         String?
  offer                  String?
  platform               String?
  format                 String?
  style                  String?
  quality                String    @default("standard")
  // Idioma dos textos do anúncio (pode ser diferente do idioma da interface)
  language               String    @default("pt-BR")
  // Pedido livre do cliente ("o que você quer no anúncio"); a IA detecta o idioma e o escopo por ele
  briefing               String?
  // Duração de cada vídeo em segundos (múltiplos de 5; cada trecho começa no último quadro do anterior)
  videoDuration          Int       @default(5)
  // Aplica o logo do Brand Kit no canto dos criativos (imagens e vídeos)
  applyLogo              Boolean   @default(false)
  // Vídeo: legendas sincronizadas com a locução e tela final com oferta, preço e chamada
  captions               Boolean   @default(true)
  endCard                Boolean   @default(true)
  // IMAGE ou VIDEO escolhido pelo cliente (null em campanhas antigas = padrão do formato)
  mediaType              String?
  // Imagens de referência enviadas pelo cliente (JSON: lista de URLs). A foto do produto é a "imagem 1".
  referencesJson         String?
  // Quando o cliente declarou ter autorização de uso de imagem das pessoas nas referências (prova, LGPD/CC art. 20)
  imageRightsConfirmedAt DateTime?
  variations             Int       @default(3)
  strategyJson           String?
  creditsCharged         Int       @default(0)
  notifiedAt             DateTime?
  status                 String // GENERATING, COMPLETED, PARTIAL, FAILED
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  creatives Creative[]

  @@index([workspaceId, createdAt])
  @@index([status])
}

model Creative {
  id           String   @id @default(uuid())
  campaignId   String
  type         String // IMAGE, VIDEO, COPY
  variantIndex Int      @default(0)
  provider     String
  model        String
  prompt       String?
  headline     String?
  text         String?
  cta          String?
  // Hashtags da legenda, separadas por espaço (ex.: "#skincare #promo")
  hashtags     String?
  outputUrl    String?
  audioUrl     String?
  // Vídeo: tempo de cada palavra da locução (JSON [{w,s,e}]) para as legendas
  captionsJson String?
  // Vídeo-mestre sem acabamento (formato da geração): base para os outros formatos
  masterUrl    String?
  // Formatos já renderizados (JSON {"9:16": url, "1:1": url})
  formatsJson  String?
  thumbnailUrl String?
  aspectRatio  String?
  width        Int?
  height       Int?
  duration     Int?
  creditsUsed  Int      @default(0)
  status       String // QUEUED, PROCESSING, COMPLETED, FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  job          GenerationJob?
  publications Publication[]
  insights     AdInsight[]

  @@index([campaignId])
}

/// Prova do aceite dos Termos de Uso e da Política de Privacidade (versão, data, IP e navegador).
/// Sem chave estrangeira: precisa sobreviver à exclusão da conta pelo prazo de guarda (5 anos, ver lib/terms.ts).
model ConsentRecord {
  id        String   @id @default(uuid())
  userId    String
  userEmail String
  version   String
  // signup_email, signup_google, reaccept
  method    String
  locale    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Prova da declaração de autorização de uso de imagem (Código Civil art. 20; LGPD art. 7º, VI e art. 16).
/// Sem chaves estrangeiras de propósito: o registro precisa sobreviver à exclusão da campanha ou da conta,
/// por isso guarda uma cópia mínima dos dados (e-mail, nome) e só o hash das imagens, não as imagens.
model ImageRightsRecord {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  userId             String?
  userEmail          String
  userName           String?
  workspaceId        String
  campaignId         String?
  campaignName       String?
  declarationVersion String
  declarationText    String
  locale             String
  imageUrls          String // JSON: URLs das imagens declaradas
  imageHashes        String // JSON: SHA-256 de cada imagem (prova qual arquivo era, mesmo depois de apagado)
  ipAddress          String?
  userAgent          String?

  @@index([createdAt])
  @@index([userEmail])
  @@index([campaignId])
}

model GenerationJob {
  id           String    @id @default(uuid())
  creativeId   String    @unique
  status       String // PENDING, PROCESSING, COMPLETED, FAILED
  attempts     Int       @default(0)
  externalData String? // JSON com request_id / status_url do provedor (ex: fal.ai)
  error        String?
  refunded     Boolean   @default(false)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model CreditBalance {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  userId      String?
  balance     Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  amount      Int // Positivo (compra/refund/bônus) ou Negativo (consumo)
  type        String // CONSUME, REFUND, PURCHASE, BONUS, ADJUSTMENT
  description String?
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([referenceId])
}

model Payment {
  id              String   @id @default(uuid())
  provider        String // STRIPE, MERCADOPAGO
  externalId      String // id da sessão (Stripe) ou do pagamento (MP)
  // Opcional: registros de pagamento são mantidos (obrigação fiscal) mesmo se a conta for excluída
  userId          String?
  workspaceId     String
  planId          String?
  credits         Int
  amount          Float
  currency        String
  status          String   @default("APPROVED") // APPROVED, PARTIALLY_REFUNDED, REFUNDED
  // Cupom usado (código) e o desconto dado, na moeda do pagamento
  couponCode      String?
  discount        Float    @default(0)
  // Estorno no gateway: quanto já foi devolvido e quantos créditos já foram retirados (idempotência)
  refundedAmount  Float    @default(0)
  refundedCredits Int      @default(0)
  // Quem pagou (para a nota fiscal): nome, CPF/CNPJ e país informados no checkout
  customerName    String?
  customerTaxId   String?
  customerCountry String?
  // Pagamento de uma assinatura (fatura mensal)
  subscriptionId  String?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Garante idempotência: o mesmo pagamento nunca credita duas vezes
  @@unique([provider, externalId])
  @@index([createdAt])
}

// Cupom de desconto criado no Admin (espelhado na Stripe como cupom + código promocional).
model Coupon {
  id                    String    @id @default(uuid())
  code                  String    @unique // sempre em maiúsculas
  percentOff            Int? // 1-100
  amountOff             Float? // desconto fixo, na moeda `currency`
  currency              String? // BRL, USD ou EUR (só para desconto fixo)
  planIdsJson           String? // pacotes em que vale (vazio = todos)
  maxRedemptions        Int?
  expiresAt             DateTime?
  active                Boolean   @default(true)
  stripeCouponId        String?
  stripePromotionCodeId String?
  stripeMode            String? // test | live (a chave da Stripe usada na criação)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Provedor de IA recusando por saldo/chave: avisa o admin e pausa o que depende dele por alguns minutos.
model ProviderAlert {
  provider      String    @id // google, fal, openai, elevenlabs
  message       String
  failures      Int       @default(1)
  lastFailureAt DateTime  @default(now())
  notifiedAt    DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model UsageRecord {
  id            String   @id @default(uuid())
  userId        String
  operation     String
  provider      String
  model         String
  credits       Int
  estimatedCost Float
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model SystemConfig {
  id                       String   @id @default("global")
  // Segredos abaixo são armazenados criptografados (AES-256-GCM, ver lib/crypto.ts)
  geminiKey                String?
  openAiKey                String?
  oviKey                   String? // Legado
  wanKey                   String? // Chave fal.ai (Wan image-to-video)
  elevenLabsKey            String?
  stripeSecretKey          String?
  stripeWebhookSecret      String?
  shopifyClientId          String?
  shopifyClientSecret      String?
  // Emissor de NFS-e (NFE.io): chave da API
  nfeioApiKey              String?
  mercadoPagoAccessToken   String?
  mercadoPagoWebhookSecret String?
  metaAppId                String?
  metaAppSecret            String?
  mercadoLivreAppId        String?
  mercadoLivreSecret       String?
  nuvemshopAppId           String?
  nuvemshopSecret          String?
  googleClientId           String?
  googleClientSecret       String?
  // Botão "Continuar com Google" (só aparece se também houver Client ID e Secret)
  googleLoginEnabled       Boolean  @default(true)
  resendKey                String?
  // Configurações gerais sem segredo (empresa, e-mails, rastreadores...), ver lib/settings.ts
  settingsJson             String?
  // Desligado = ninguém consegue criar conta nova (e-mail ou Google)
  signupsEnabled           Boolean  @default(true)
  aiCostsJson              String?
  // Vitrine da landing (criativos de exemplo escolhidos no Admin), ver lib/showcase.ts
  showcaseJson             String?
  plansJson                String?
  modelsJson               String?
  // Ofertas de teste grátis: tudo desligado até o super admin ativar
  freeTrialEnabled         Boolean  @default(false) // dá signupCredits no cadastro
  freePlanVisible          Boolean  @default(false) // mostra o card "Grátis" na landing
  signupCredits            Int      @default(30)
  updatedAt                DateTime @updatedAt
}

// Convite para participar de um workspace (o link vale 7 dias; guardamos só o hash do token).
model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        String    @default("MEMBER") // ADMIN, MEMBER
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

// Assinatura mensal na Stripe: a cada fatura paga, o workspace recebe os créditos do plano.
model Subscription {
  id                       String    @id @default(uuid())
  workspaceId              String
  userId                   String?
  stripeSubscriptionId     String    @unique
  stripeCustomerId         String
  planId                   String
  planName                 String
  creditsPerPeriod         Int
  status                   String // active, trialing, past_due, canceled, incomplete, unpaid
  currency                 String
  amount                   Float
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean   @default(false)
  // Cancelamento pedido pelo cliente e a taxa (se houver): NONE, WAIVED (7 dias), PAID, FAILED
  cancelRequestedAt        DateTime?
  canceledAt               DateTime?
  cancellationFee          Float     @default(0)
  cancellationFeeStatus    String?
  cancellationFeeInvoiceId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

// Anúncio pago criado na Meta (Marketing API) a partir de um criativo. Sempre nasce PAUSADO.
model MetaAd {
  id                 String   @id @default(uuid())
  workspaceId        String
  creativeId         String
  adAccountId        String // act_...
  pageId             String
  name               String
  objective          String // OUTCOME_TRAFFIC, OUTCOME_SALES, OUTCOME_AWARENESS, OUTCOME_ENGAGEMENT
  dailyBudget        Int // em centavos da moeda da conta
  currency           String
  countries          String // "BR,PT"
  link               String
  // Textos e opções do anúncio: {instagramId, cta, headline, message}
  optionsJson        String?
  status             String   @default("PENDING") // PENDING, PROCESSING, CREATED, FAILED
  externalCampaignId String?
  externalAdSetId    String?
  externalAdId       String?
  error              String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Nota fiscal de serviço (NFS-e) de um pagamento. Só é emitida com o emissor configurado no Admin.
model FiscalInvoice {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  provider   String // NFEIO
  status     String   @default("PENDING") // PENDING, PROCESSING, ISSUED, FAILED, CANCELED
  externalId String?
  number     String?
  pdfUrl     String?
  error      String?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, updatedAt])
}
